# Development reference. Prefer init_deployment.py --engine stub for random
# credentials, available ports/subnets and pre-created external volumes.
COMPOSE_PROJECT_NAME=video-dev
ENGINE=stub
MODEL=
DELIVERY=both
# Local free development values only. Never reuse these in production.
BOOTSTRAP_SECRET=devsecret
RUNNER_ADMIN_TOKEN=change-me
ENGINE_CONTROLLER_TOKEN=development-only-controller-token-change-me
ORCHESTRATOR_PORT=8935
RUNNER_ADMIN_PORT=8990
SUBNET_PREFIX=172.30.88
CONTROL_SUBNET_PREFIX=172.30.89
ENGINE_SUBNET_PREFIX=172.30.90
DOCKER_API_SUBNET_PREFIX=172.30.91
HF_CACHE_VOLUME=livepeer-video-hf-cache
MODELS_VOLUME=livepeer-video-model-weights
ENGINE_CACHE_VOLUME=livepeer-video-engine-cache
CONTROLLER_STATE_VOLUME=video-dev-controller-state
GPU_LEASE_VOLUME=livepeer-video-gpu-leases
# Optional real GPU profile; prepare its pinned images/weights explicitly first.
ENGINE_GPU_UUID=
# For rootless Docker, set this to the actual configured daemon socket.
DOCKER_SOCKET_PATH=/var/run/docker.sock
