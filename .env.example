# Copy to .env and edit. Every value has a default in compose.yml.

# stub | lightx2v | sglang | vllm-omni
ENGINE=stub
# Catalog id from models/<ENGINE>.json; empty = the catalog's default.
MODEL=
# single-shot | persistent | both
DELIVERY=both

# livepeer-node source the orchestrator image is built from: a git URL pinned
# to a commit (the default) or a local checkout, e.g. ../node.
LIVEPEER_NODE_SOURCE=https://github.com/livepeer/node.git#08081dbda0f4f7b56e362e3af4b6965bfa1b73a4

# Shared by orchestrator and runner (dynamic registration).
BOOTSTRAP_SECRET=devsecret
# Bearer token for POST http://127.0.0.1:8990/admin/model.
RUNNER_ADMIN_TOKEN=change-me

# Model weights.
HF_TOKEN=
HF_CACHE_DIR=~/.cache/huggingface
MODELS_DIR=./weights
GPU_ID=0

# First three octets of the compose network (/24). The runner gets .10, which the
# orchestrator grants (livepeer-node grants take IPs only). Change on a clash.
SUBNET_PREFIX=172.30.88
