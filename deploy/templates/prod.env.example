# Reference only. Generate a private file with init_deployment.py --existing-orchestrator.
# 192.0.2.0/24 is documentation-only; replace with reachable private addresses.
COMPOSE_PROJECT_NAME=video-engines
ENGINE=all
MODEL=
DELIVERY=both
ENGINE_GPU_UUID=GPU-your-reserved-uuid
ORCHESTRATOR_URL=http://192.0.2.10:8935
RUNNER_URL=http://192.0.2.20:8989
RUNNER_BIND_HOST=192.0.2.20
RUNNER_PORT=8989
RUNNER_ADMIN_PORT=8990
# Match the node's bootstrap secret; generate independent admin/control tokens.
BOOTSTRAP_SECRET=
RUNNER_ADMIN_TOKEN=
ENGINE_CONTROLLER_TOKEN=
HF_CACHE_VOLUME=livepeer-video-hf-cache
MODELS_VOLUME=livepeer-video-model-weights
ENGINE_CACHE_VOLUME=livepeer-video-engine-cache
CONTROLLER_STATE_VOLUME=video-engines-controller-state
GPU_LEASE_VOLUME=livepeer-video-gpu-leases
# Defaults shown; the initializer selects unused ranges on the actual host.
SUBNET_PREFIX=172.30.88
CONTROL_SUBNET_PREFIX=172.30.89
ENGINE_SUBNET_PREFIX=172.30.90
DOCKER_API_SUBNET_PREFIX=172.30.91
USE_EXISTING_ORCHESTRATOR=1
# Optional ingress.yml overlay; reserve/grant the literal runner IP on the node.
EXISTING_ORCHESTRATOR_NETWORK=
EXISTING_RUNNER_IP=
