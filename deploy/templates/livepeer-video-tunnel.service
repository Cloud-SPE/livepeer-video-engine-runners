[Unit]
Description=Private SSH tunnel to the Livepeer video orchestrator
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=0

[Service]
EnvironmentFile=%h/.config/livepeer-video/tunnel.env
ExecStart=/usr/bin/ssh -NT -o BatchMode=yes -o ExitOnForwardFailure=yes -o ServerAliveInterval=15 -o ServerAliveCountMax=3 -L 127.0.0.1:${LOCAL_ORCHESTRATOR_PORT}:127.0.0.1:${REMOTE_ORCHESTRATOR_PORT} -L 127.0.0.1:${LOCAL_ADMIN_PORT}:127.0.0.1:${REMOTE_ADMIN_PORT} ${ORCHESTRATOR_SSH_HOST}
Restart=always
RestartSec=3

[Install]
WantedBy=default.target
