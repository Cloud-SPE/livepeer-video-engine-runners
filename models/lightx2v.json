{
  "default": "wan2.1-t2v-1.3b",
  "models": [
    {
      "id": "wan2.1-t2v-1.3b",
      "engine": "lightx2v",
      "command": [
        "python",
        "-m",
        "lightx2v.server",
        "--model_cls",
        "wan2.1",
        "--task",
        "t2v",
        "--model_path",
        "/models/Wan2.1-T2V-1.3B",
        "--config_json",
        "/app/configs/lightx2v/wan21_t2v_1_3b.json",
        "--host",
        "127.0.0.1",
        "--port",
        "9100",
        "--max_queue_size",
        "2"
      ],
      "port": 9100,
      "env": {
        "PYTHONPATH": "/opt/lightx2v",
        "PYTORCH_CUDA_ALLOC_CONF": "expandable_segments:True"
      },
      "defaults": {
        "width": 832,
        "height": 480,
        "num_frames": 81
      }
    },
    {
      "id": "minimax-h3-4step",
      "engine": "lightx2v",
      "command": [
        "python",
        "-m",
        "lightx2v.server",
        "--model_cls",
        "minimax_h3",
        "--model-variant",
        "fl2av",
        "--task",
        "t2av",
        "--model_path",
        "/models/MiniMax-H3",
        "--config_json",
        "/app/configs/lightx2v/minimax_h3_int8_4step_offload.json",
        "--host",
        "127.0.0.1",
        "--port",
        "9100",
        "--max_queue_size",
        "2"
      ],
      "port": 9100,
      "startup_timeout_s": 3600,
      "job_timeout_s": 3600,
      "env": {
        "PYTHONPATH": "/opt/lightx2v",
        "PYTORCH_CUDA_ALLOC_CONF": "expandable_segments:True"
      },
      "defaults": {
        "width": 768,
        "height": 448,
        "num_frames": 121
      }
    }
  ]
}
